{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "oxc", "import"],
  "env": {
    "node": true,
    "vitest": true
  },
  "categories": {
    "suspicious": "error"
  },
  "rules": {
    "import/no-unassigned-import": "off",
    "typescript/consistent-type-imports": "error",
    "typescript/no-useless-empty-export": "off"
  }
}
