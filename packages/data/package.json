{
  "name": "@cieloazul310/regista-data",
  "description": "Simple and type-safe Markdown/MDX content management tool for Next.js App Router",
  "version": "1.3.3",
  "license": "MIT",
  "author": {
    "name": "@cieloazul310",
    "url": "https://cieloazul310.github.io"
  },
  "keywords": [
    "Next.js",
    "App Router",
    "MDX"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cieloazul310/regista.git",
    "directory": "packages/data"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint src __tests__ --fix"
  },
  "dependencies": {
    "@cieloazul310/regista-utils": "^1.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "zod": "^4.6.7"
  },
  "lint-staged": {
    "**/*.{js,cjs,mjs,ts}": [
      "oxlint --fix",
      "prettier --parser typescript --write"
    ]
  }
}