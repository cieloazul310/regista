{
  "name": "@cieloazul310/regista-mdx",
  "description": "Simple and type-safe Markdown/MDX content management tool for Next.js App Router",
  "version": "1.3.0",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": {
    "name": "@cieloazul310",
    "url": "https://cieloazul310.github.io"
  },
  "keywords": [
    "Next.js",
    "App Router",
    "MDX"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint src __tests__ --fix"
  },
  "dependencies": {
    "@cieloazul310/regista-utils": "^1.3.0",
    "vfile": "^6.0.3",
    "vfile-matter": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@repo/typescript-config": "*",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0"
  },
  "peerDependencies": {
    "@mdx-js/mdx": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "zod": "^4.0.0"
  },
  "lint-staged": {
    "**/*.{js,cjs,mjs,ts}": [
      "oxlint --fix",
      "prettier --parser typescript --write"
    ]
  }
}